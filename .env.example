# Angel One SmartAPI credentials (the same account you already use). Never commit the real .env.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Optional. Angel allows ONE active login per client code. If another project (for example Navrist) logs in with the same client code,
# point both projects at the same session file so they share one login instead of invalidating each other.
# ANGEL_SESSION_FILE=C:\path\to\shared\angel_session.json

# Optional. Where recorded depth snapshots are kept (default: ./data/depth.db) and the server address (default 127.0.0.1:8100).
# HEATCHART_DB=
# HEATCHART_HOST=127.0.0.1
# HEATCHART_PORT=8100
